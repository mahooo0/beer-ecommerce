generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTH DOMAIN (handled by Plan 03)
// ============================================================================

model User {
  id          String       @id @default(cuid())
  clerkId     String       @unique
  email       String       @unique
  firstName   String
  lastName    String
  role        Role         @default(CUSTOMER)
  // Storefront segment. Kept separate from `role` so admin RBAC and the
  // retail/wholesale distinction never collide.
  customerType CustomerType @default(RETAIL)
  companyName String?      // wholesale: "Nazwa firmy"
  taxId       String?      // wholesale: NIP / tax id (optional)
  avatar      String?      // URL to user avatar
  phone       String?      // unverified, captured at sign-up; identifier lives on CustomerPhone
  isActive    Boolean      @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  addresses Address[]
  reviews   Review[]
  wishlists Wishlist[]

  // The phone number is the customer identifier that carries a discount. Many
  // accounts (or guest checkouts) may resolve to the same CustomerPhone.
  customerPhoneId String?
  customerPhone   CustomerPhone? @relation(fields: [customerPhoneId], references: [id], onDelete: SetNull)

  @@index([clerkId])
  @@index([role])
  @@index([customerType])
  @@index([customerPhoneId])
  @@map("users")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

// Phone-number-as-customer-identifier. The number (normalized) is the unique
// key; a discount can be attached to it and is inherited by any account or
// guest order that presents the same number. Phone is NOT verified via Clerk —
// it is captured as plain data at sign-up / checkout.
model CustomerPhone {
  id            String        @id @default(cuid())
  phone         String        @unique // normalized (E.164-ish)
  // --- discount payload: created nullable now, populated in Phase 2 ---
  discountType  DiscountType?
  discountValue Int?          // percentage (15 = 15%) or cents, per discountType
  note          String?       // admin note, e.g. why this number gets a discount
  users         User[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([phone])
  @@map("customer_phones")
}

// ============================================================================
// ADDRESS DOMAIN
// ============================================================================

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  street    String
  street2   String?  // apartment, suite, etc.
  city      String
  state     String
  zipCode   String
  country   String
  phone     String?
  isDefault Boolean  @default(false)
  label     String?  // "Home", "Work", etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ============================================================================
// WISHLIST DOMAIN
// ============================================================================

model Wishlist {
  id        String         @id @default(cuid())
  name      String         @default("My Wishlist")
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  isPublic  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id                 String   @id @default(cuid())
  wishlistId         String
  wishlist           Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt            DateTime @default(now())
  priceAtAdd         Int      @default(0)
  notifyOnPriceDrop  Boolean  @default(true)
  notifyOnRestock    Boolean  @default(true)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

// ============================================================================
// REVIEW DOMAIN
// ============================================================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

model Review {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating             Int          // 1-5, validated in application layer
  title              String?
  body               String?      @db.Text
  photos             String[]     // array of URLs
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(PENDING)
  helpfulCount       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([userId, productId]) // one review per user per product
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([productId, status]) // for fetching approved reviews per product
  @@map("reviews")
}

// ============================================================================
// PRODUCT CATALOG DOMAIN
// ============================================================================

enum ProductType {
  SIMPLE
  VARIABLE
  WEIGHTED
  DIGITAL
  BUNDLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WeightUnit {
  KG
  LB
  OZ
  G
}

enum AttributeType {
  SELECT
  RANGE
  BOOLEAN
  TEXT
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String   @db.Text
  price           Int      // cents — regular price ("цена")
  salePrice       Int?     // cents — active discount price ("цена со скидкой"); when set it is the selling price and `price` shows struck-through
  compareAtPrice  Int?     // legacy original-price field (unused by the new product form)
  baseUnit        String   @default("piece") // базовая единица прайса
  images          String[] // array of URLs
  sku             String   @unique
  manufacturer    String?  // виробник
  composition     String?  @db.Text // склад (rich HTML, same format as description)
  searchKeywords  String[] @default([]) // ключевые слова (persisted; admin input is disabled)
  productType     ProductType @default(SIMPLE)
  status          ProductStatus @default(DRAFT)
  attributes      Json     @default("{}") // legacy JSONB dynamic attributes (superseded by ProductAttributeValue)
  // Wholesale quantity pricing: [{ minQty, price }] (price = total cents for minQty units).
  // Applied only to WHOLESALE customers; retail always pays the regular unit price.
  wholesaleTiers  Json     @default("[]")
  // Stock — dual mode: trackQuantity=true → numeric `quantity` that decrements on order;
  // trackQuantity=false → manual `isAvailable` in/out-of-stock flag (no number tracked)
  trackQuantity   Boolean  @default(false)
  quantity        Int      @default(0)
  isAvailable     Boolean  @default(true) // в наявності (manual flag, independent of quantity)
  isActive        Boolean  @default(true)
  allowPreorder   Boolean  @default(false)

  // Relations
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brandId         String?
  brand           Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)

  variants        ProductVariant[]
  tags            ProductTag[]
  collections     ProductCollection[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  attributeValues ProductAttributeValue[] // normalized per-category attribute selections

  // Type-specific metadata
  digitalMeta     DigitalMeta?
  weightedMeta    WeightedMeta?
  bundleItems     BundleItem[] @relation("BundleProduct")
  includedInBundles BundleItem[] @relation("BundledProduct")
  promoBanners    PromoBanner[] // marketing blocks linking to this product

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Indexes
  @@index([categoryId])
  @@index([brandId])
  @@index([sku])
  @@index([productType])
  @@index([status])
  @@index([attributes], type: Gin)
  @@map("products")
}

model DigitalMeta {
  id              String   @id @default(cuid())
  productId       String   @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileUrl         String   // Cloudinary URL
  fileName        String
  fileSize        Int      // bytes
  fileFormat      String   // e.g., "pdf", "zip", "mp3"
  maxDownloads    Int?     // null = unlimited
  accessDuration  Int?     // days, null = lifetime

  @@map("digital_metas")
}

model WeightedMeta {
  id              String     @id @default(cuid())
  productId       String     @unique
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit            WeightUnit
  pricePerUnit    Int        // cents
  minWeight       Float?     // minimum order weight
  maxWeight       Float?     // maximum order weight
  stepWeight      Float?     // increment step, e.g., 0.1 for 100g steps

  @@map("weighted_metas")
}

model BundleItem {
  id              String   @id @default(cuid())
  bundleProductId String
  bundleProduct   Product  @relation("BundleProduct", fields: [bundleProductId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation("BundledProduct", fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int      @default(1)
  discount        Int      @default(0) // cents off per item in bundle

  @@unique([bundleProductId, productId])
  @@index([bundleProductId])
  @@index([productId])
  @@map("bundle_items")
}

// ============================================================================
// CATEGORY DOMAIN
// ============================================================================

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String?    @db.Text
  image           String?    // category image URL
  path            String     // materialized path: "/electronics/phones/smartphones"
  depth           Int        @default(0)
  position        Int        @default(0) // sort order among siblings

  // Self-referential tree
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[] @relation("CategoryTree")

  // Relations
  products        Product[]
  attributes      CategoryAttribute[] // legacy flat attributes (retired once new UI ships)
  attributeDefs   Attribute[]         // normalized attribute definitions (4fr-style)
  filters         CategoryFilter[]    // manual category filters
  promoBanners    PromoBanner[]       // marketing blocks linking to this category

  // SEO
  metaTitle       String?
  metaDescription String?

  // Timestamps
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([path])
  @@index([parentId])
  @@map("categories")
}

model CategoryAttribute {
  id              String        @id @default(cuid())
  name            String        // display name: "Screen Size"
  key             String        // machine key: "screen_size"
  type            AttributeType
  values          String[]      // possible values: ["32 inch", "55 inch", "65 inch"]
  unit            String?       // e.g., "inch", "cm", "GB"
  isFilterable    Boolean       @default(true)
  isRequired      Boolean       @default(false)
  position        Int           @default(0) // display order

  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key]) // one attribute key per category
  @@index([categoryId])
  @@map("category_attributes")
}

// ============================================================================
// STRUCTURED ATTRIBUTES (normalized, 4fr-style) + CATEGORY FILTERS
// ============================================================================

// Per-category attribute definition (e.g. "Вага", "Смак", "Порода").
model Attribute {
  id                     String   @id @default(cuid())
  categoryId             String
  category               Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                   String   // machine slug (snake_case)
  displayName            String   // shown to admins/users
  isFilterable           Boolean  @default(true)
  isVisibleOnProductPage Boolean  @default(true)
  usedForVariations      Boolean  @default(false) // column kept; UI toggle disabled (no variants)
  showValueIcons         Boolean  @default(false)
  displayType            String   @default("checkbox") // checkbox | select | button | color | range
  sortOrder              Int      @default(0)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  values                 AttributeValue[]
  productAttributeValues ProductAttributeValue[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("attributes")
}

// Reusable value belonging to an attribute — the "common option / общая опция".
model AttributeValue {
  id           String    @id @default(cuid())
  attributeId  String
  attribute    Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value        String    // machine value
  displayValue String?   // shown label
  colorCode    String?   // for displayType=color
  iconUrl      String?   // optional value icon
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  productAttributeValues ProductAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_values")
}

// Junction: which attribute values a product has chosen.
model ProductAttributeValue {
  id               String         @id @default(cuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId      String
  attribute        Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([productId, attributeId, attributeValueId])
  @@index([productId])
  @@index([attributeId])
  @@index([attributeValueId])
  @@map("product_attribute_values")
}

// Manual category filter ("добавить фильтр для категории"), distinct from attributes.
model CategoryFilter {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String   // machine slug
  displayName String
  type        String   @default("select") // select | multi-select | range | checkbox
  source      String   @default("manual") // manual | manufacturer
  required    Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options CategoryFilterOption[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("category_filters")
}

model CategoryFilterOption {
  id        String         @id @default(cuid())
  filterId  String
  filter    CategoryFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)
  value     String
  label     String?
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([filterId])
  @@map("category_filter_options")
}

// ============================================================================
// PRODUCT VARIANT & OPTIONS DOMAIN
// ============================================================================

model ProductVariant {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String          @unique
  price           Int             // cents, overrides base product price
  compareAtPrice  Int?
  stock           Int             @default(0)
  isActive        Boolean         @default(true)
  images          String[]        // variant-specific images

  options         VariantOption[]
  inventoryItems  InventoryItem[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model OptionGroup {
  id              String        @id @default(cuid())
  name            String        @unique // "Size", "Color", "Material"
  displayName     String        // user-facing label
  values          OptionValue[]
  createdAt       DateTime      @default(now())

  @@map("option_groups")
}

model OptionValue {
  id              String          @id @default(cuid())
  value           String          // "Large", "Red", "#FF0000"
  label           String?         // optional display label different from value
  groupId         String
  group           OptionGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  variantOptions  VariantOption[]

  @@unique([groupId, value])
  @@index([groupId])
  @@map("option_values")
}

model VariantOption {
  id              String         @id @default(cuid())
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionId        String
  option          OptionValue    @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionId])
  @@index([variantId])
  @@index([optionId])
  @@map("variant_options")
}

// ============================================================================
// DISCOUNT & PROMOTION DOMAIN
// ============================================================================

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum PromotionType {
  BOGO
  TIERED_PRICING
  FLASH_SALE
  AUTOMATIC_DISCOUNT
}

model Coupon {
  id                    String       @id @default(cuid())
  code                  String       @unique
  description           String?
  discountType          DiscountType
  discountValue         Int          // percentage as whole number (15 = 15%) or cents for fixed
  minOrderAmount        Int?         // cents, minimum cart total to apply
  maxDiscountAmount     Int?         // cents, cap for percentage discounts
  usageLimit            Int?         // null = unlimited
  usageCount            Int          @default(0)
  perCustomerLimit      Int          @default(1)
  applicableProductIds  String[]     // empty = all products
  applicableCategoryIds String[]     // empty = all categories
  startsAt              DateTime
  expiresAt             DateTime?
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([code])
  @@index([isActive, startsAt, expiresAt])
  @@map("coupons")
}

model Promotion {
  id                    String        @id @default(cuid())
  name                  String
  description           String?
  type                  PromotionType
  discountType          DiscountType
  discountValue         Int           // cents or percentage
  conditions            Json          @default("{}") // JSONB for flexible conditions
  applicableProductIds  String[]
  applicableCategoryIds String[]
  stackable             Boolean       @default(false)
  priority              Int           @default(0) // higher = applied first
  usageLimit            Int?
  usageCount            Int           @default(0)
  startsAt              DateTime
  expiresAt             DateTime?
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([isActive, startsAt, expiresAt])
  @@index([type])
  @@map("promotions")
}

// ============================================================================
// SHIPPING DOMAIN
// ============================================================================

enum ShippingRateType {
  FLAT_RATE
  WEIGHT_BASED
  PRICE_BASED
}

model ShippingZone {
  id                    String           @id @default(cuid())
  name                  String           // "Continental US", "Europe"
  countries             String[]         // ISO country codes
  states                String[]         // optional, for zone subdivision
  isActive              Boolean          @default(true)
  methods               ShippingMethod[]
  freeShippingThreshold Int?             // cents, null = no free shipping
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@map("shipping_zones")
}

model ShippingMethod {
  id                String           @id @default(cuid())
  name              String           // "Standard Shipping", "Express"
  description       String?
  zoneId            String
  zone              ShippingZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rateType          ShippingRateType
  flatRate          Int?             // cents, for FLAT_RATE
  weightRate        Int?             // cents per kg, for WEIGHT_BASED
  minWeight         Float?           // kg
  maxWeight         Float?           // kg
  priceThresholds   Json?            // JSONB for PRICE_BASED
  estimatedDaysMin  Int?
  estimatedDaysMax  Int?
  isActive          Boolean          @default(true)
  position          Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([zoneId])
  @@map("shipping_methods")
}

// ============================================================================
// WAREHOUSE & INVENTORY DOMAIN
// ============================================================================

enum StockMovementReason {
  SALE
  RETURN
  MANUAL_ADJUSTMENT
  DAMAGE
  RESTOCK
  RESERVATION
  RESERVATION_RELEASE
}

model Warehouse {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique // short identifier
  address        String
  city           String
  state          String
  country        String
  zipCode        String
  latitude       Float?
  longitude      Float?
  priority       Int             @default(0) // higher = preferred for allocation
  isActive       Boolean         @default(true)
  inventoryItems InventoryItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("warehouses")
}

model InventoryItem {
  id                String          @id @default(cuid())
  variantId         String
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity          Int             @default(0)
  reserved          Int             @default(0) // held during checkout
  lowStockThreshold Int             @default(5)
  movements         StockMovement[]

  @@unique([variantId, warehouseId]) // one inventory record per variant per warehouse
  @@index([variantId])
  @@index([warehouseId])
  @@map("inventory_items")
}

model StockMovement {
  id              String              @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Int                 // positive for additions, negative for removals
  reason          StockMovementReason
  reference       String?             // order ID, adjustment ID, etc.
  note            String?
  createdAt       DateTime            @default(now())

  @@index([inventoryItemId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ============================================================================
// BRAND, TAG, COLLECTION DOMAIN
// ============================================================================

model Brand {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  description     String?   @db.Text
  logo            String?   // URL
  website         String?
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("brands")
}

// Editable marketing block (e.g. the homepage "promo" section). Admin uploads an
// image + bilingual text and links it to a product or a category (or a raw href).
// Text fields are localized JSON `{ "pl": "...", "uk": "..." }` because the
// storefront is bilingual while product/category names in the DB are single-language.
model PromoBanner {
  id          String    @id @default(cuid())
  title       Json      @default("{}") // localized heading { pl, uk } (\n allowed for multi-line)
  subtitle    Json      @default("{}") // localized body text { pl, uk }
  ctaLabel    Json      @default("{}") // localized CTA button label { pl, uk }
  image       String    // uploaded image URL (MinIO)

  // CTA target: a real FK to a product or category, or a raw href fallback.
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  href        String?   // custom link, used when neither product nor category is set

  isActive    Boolean   @default(true)
  position    Int       @default(0) // sort order; the storefront shows the active one with lowest position

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, position])
  @@index([productId])
  @@index([categoryId])
  @@map("promo_banners")
}

// Loyalty discount tiers (N rows, admin-managed). Applied only to RETAIL
// customers: the highest active tier whose `minSpendCents` the customer's
// lifetime cumulative PAID spend reaches grants `percent` off the goods
// subtotal at checkout. Wholesale customers use quantity tiers instead.
model LoyaltyTier {
  id            String   @id @default(cuid())
  minSpendCents Int      // lifetime cumulative paid spend (cents) to reach this tier
  percent       Int      // discount percent (0–100) applied to the goods subtotal
  active        Boolean  @default(true)
  position      Int      @default(0) // display / sort order

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, minSpendCents])
  @@map("loyalty_tiers")
}

// Lightweight, append-only behavioral event log powering the admin funnel +
// abandoned-cart reports. Guests are tracked by an anonymous browser `sessionId`
// (client localStorage); signed-in users additionally carry `userId` (Clerk id,
// best-effort attribution — NOT a security boundary). Money is in cents.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String   // product_view | add_to_cart | remove_from_cart | checkout_started | search | purchased
  sessionId   String   // anonymous browser session id (always present)
  userId      String?  // Clerk id when signed in (best-effort)
  isWholesale Boolean  @default(false)

  productId   String?  // product_view / add_to_cart / remove_from_cart
  quantity    Int?     // add_to_cart / remove_from_cart line quantity
  itemCount   Int?     // cart size snapshot at event time
  valueCents  Int?     // cart subtotal (add_to_cart / checkout_started) or order total (purchased)
  query       String?  // search term
  orderId     String?  // purchased — links the Mongo order id
  email       String?  // guest email captured at checkout (for recovery lists)
  meta        Json?    // extensible bag

  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("analytics_events")
}

// Store-wide admin notifications (not per-user): the bell in the admin shell.
// Written server-side from domain events (new order, order shipped, low stock).
// `read` is a shared flag across the admin team — good enough for a small shop.
model Notification {
  id        String   @id @default(cuid())
  type      String   // order.created | order.shipped | inventory.lowStock
  level     String   @default("info") // info | success | warning
  title     String
  body      String?
  orderId   String?  // Mongo order id, for order-related notifications
  productId String?  // for inventory notifications
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

enum TagType {
  PRODUCT
  COLLECTION
  BLOG
  CUSTOM
}

model Tag {
  id              String       @id @default(cuid())
  name            String       @unique
  slug            String       @unique
  type            TagType      @default(PRODUCT)
  products        ProductTag[]
  createdAt       DateTime     @default(now())

  @@map("tags")
}

model ProductTag {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId           String
  tag             Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([productId])
  @@index([tagId])
  @@map("product_tags")
}

model Collection {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  description     String?             @db.Text
  image           String?             // URL
  isActive        Boolean             @default(true)
  products        ProductCollection[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("collections")
}

model ProductCollection {
  id              String     @id @default(cuid())
  productId       String
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId    String
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  position        Int        @default(0) // sort order within collection

  @@unique([productId, collectionId])
  @@index([productId])
  @@index([collectionId])
  @@map("product_collections")
}
